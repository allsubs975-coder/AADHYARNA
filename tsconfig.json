{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "resolveJsonModule": true,
    "allowJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.astro", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules", "private", "scripts", "reports"]
}
