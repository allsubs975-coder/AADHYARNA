---
import { home } from '../../config/content';
import Logo from '../Logo.astro';

const c = home.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{c.overline}</p>
      <hr class="rule rule--short" />
      <h1 id="hero-title">{c.headline}</h1>
      <p class="lede">{c.support}</p>
      <div class="cluster hero__actions">
        <a class="btn btn--primary" href={c.primaryCta.href}>{c.primaryCta.label}</a>
        <a class="btn btn--outline" href={c.secondaryCta.href}>{c.secondaryCta.label}</a>
      </div>
    </div>

    <div class="hero__panel">
      <Logo variant="ink" size="lg" showWordmark={false} />
      <hr class="hero__rule" />
      <p class="hero__caption">
        Antique, European, Old Miner and rare fancy cuts — catalogued from one working
        inventory.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.75rem, 7vw, 5.5rem);
    overflow: hidden;
    background-color: var(--color-ivory);
    background-image: radial-gradient(
        75% 130% at 85% -10%,
        rgb(201 162 75 / 0.26),
        transparent 62%
      ),
      radial-gradient(
        60% 110% at -5% 105%,
        rgb(150 104 44 / 0.16),
        transparent 68%
      ),
      linear-gradient(180deg, rgb(255 255 255 / 0.7), transparent 45%);
  }

  /* Champagne spotlight that pools behind the copy column */
  .hero::before {
    content: '';
    position: absolute;
    left: -12%;
    top: -30%;
    width: 55vw;
    height: 55vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(
      circle,
      rgb(216 184 119 / 0.22),
      transparent 65%
    );
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: clamp(var(--space-8), 5vw, var(--space-16));
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 34ch;
  }

  .hero__copy h1 {
    font-size: var(--text-4xl);
    font-weight: 500;
  }

  .hero__copy .lede {
    max-width: 44ch;
  }

  .hero__actions {
    margin-top: var(--space-3);
    gap: var(--space-3);
  }

  .hero__actions :global(.btn) {
    flex: 1 1 auto;
    min-width: min(100%, 14rem);
  }

  .hero__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    padding: clamp(1.75rem, 5vw, 3rem);
    position: relative;
    background:
      radial-gradient(
        90% 70% at 50% 0%,
        rgb(216 184 119 / 0.16),
        transparent 70%
      ),
      linear-gradient(165deg, #222015, var(--color-ink) 65%);
    border: 1px solid rgb(201 162 75 / 0.4);
    border-radius: var(--radius-lg);
    box-shadow: var(--glow-ink), inset 0 1px 0 rgb(255 255 255 / 0.06);
    overflow: hidden;
  }

  /* Slow diagonal light band across the dark panel */
  .hero__panel::after {
    content: '';
    position: absolute;
    inset: -40% -60%;
    background: linear-gradient(
      115deg,
      transparent 42%,
      rgb(255 255 255 / 0.05) 50%,
      rgb(216 184 119 / 0.08) 54%,
      transparent 62%
    );
    transform: translateX(-35%);
    pointer-events: none;
  }

  .hero__panel > * {
    position: relative;
    z-index: 1;
  }

  .hero__panel :global(img) {
    width: min(100%, 24rem);
    height: auto;
  }

  .hero__rule {
    width: 72px;
    height: 1px;
    border: 0;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-gold-bright) 30%,
      var(--color-gold-bright) 70%,
      transparent
    );
    opacity: 0.85;
  }

  .hero__caption {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-ivory);
    max-width: 30ch;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .hero__copy h1 {
      font-size: clamp(2.75rem, 4.4vw, 4.25rem);
    }

    .hero__actions :global(.btn) {
      flex: 0 0 auto;
    }
  }
</style>
