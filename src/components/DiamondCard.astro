---
/**
 * Product card — server-rendered for every diamond, then enhanced by the
 * shared actions script (save / compare). The whole card is a single link;
 * the two toggle buttons are siblings of that link so nothing interactive is
 * nested inside another interactive element.
 *
 * `filterable` adds the data-* attributes the catalogue uses to re-filter and
 * re-sort without shipping the inventory to the client a second time.
 */
import { features } from '../config/features';
import { familyById } from '../config/shapes';
import type { Diamond } from '../lib/types';
import { formatCarat, orDash, availabilityLabel } from '../lib/format';
import ShapeSilhouette from './ShapeSilhouette.astro';
import Icon from './Icon.astro';

interface Props {
  diamond: Diamond;
  /** Adds filter data attributes (catalogue grid only). */
  filterable?: boolean;
  class?: string;
}

const { diamond: d, filterable = false, class: className = '' } = Astro.props;
const family = familyById(d.shapeFamily);
const href = `/diamonds/${encodeURIComponent(d.id)}/`;

const availability = (d.availability ?? '').trim().toUpperCase();
const isAvailable = availability === 'YES' || availability === 'AVAILABLE';

const attrs = filterable
  ? {
      'data-family': d.shapeFamily,
      'data-shape': d.shape,
      'data-weight': String(d.weight),
      'data-color': d.color,
      'data-color-type': d.colorType,
      'data-clarity': d.clarity,
      'data-polish': d.polish ?? '',
      'data-sym': d.symmetry ?? '',
      'data-fl': d.fluorescence ?? '',
      'data-availability': d.availability,
      'data-report': d.hasReport ? 'yes' : 'no',
      'data-depth': d.depth === null ? '' : String(d.depth),
      'data-table': d.table === null ? '' : String(d.table),
    }
  : {};
---

<article class:list={['dcard', className]} data-diamond-card data-id={d.id} {...attrs}>
  <a class="dcard__link" href={href}>
    <div class="dcard__media" aria-hidden="true">
      <ShapeSilhouette id={family.silhouette} size="lg" class="dcard__sil" />
      <span class="dcard__family">{family.label}</span>
    </div>

    <div class="dcard__body">
      <p class="dcard__id tabular">{d.id}</p>
      <h3 class="dcard__title">
        <span class="dcard__carat tabular">{formatCarat(d.weight)}</span>
        <span class="dcard__shape">{d.shape}</span>
      </h3>

      <dl class="dcard__specs">
        <div>
          <dt>Colour</dt>
          <dd>{d.color}</dd>
        </div>
        <div>
          <dt>Clarity</dt>
          <dd>{d.clarity}</dd>
        </div>
        <div>
          <dt>Polish</dt>
          <dd>{orDash(d.polish)}</dd>
        </div>
        <div>
          <dt>Symmetry</dt>
          <dd>{orDash(d.symmetry)}</dd>
        </div>
      </dl>

      <span class="dcard__cta">
        View details
        <Icon name="arrowRight" size={15} />
      </span>
    </div>
  </a>

  <div class="dcard__actions">
    {
      features.wishlist && (
        <button
          type="button"
          class="dcard__toggle"
          data-wishlist-toggle={d.id}
          aria-pressed="false"
        >
          <Icon name="heart" size={16} />
          <span class="sr-only">{d.id} </span>
          <span data-toggle-text>Save</span>
        </button>
      )
    }
    {
      features.compare && (
        <button
          type="button"
          class="dcard__toggle"
          data-compare-toggle={d.id}
          aria-pressed="false"
        >
          <Icon name="compare" size={16} />
          <span class="sr-only">{d.id} </span>
          <span data-toggle-text>Compare</span>
        </button>
      )
    }
    <span class:list={['dcard__avail', isAvailable && 'dcard__avail--on']}>
      {availabilityLabel(d.availability)}
    </span>
  </div>
</article>

<style>
  .dcard {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-paper);
    background-image: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.85),
      rgb(255 255 255 / 0) 38%
    );
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    transition:
      border-color 280ms var(--ease),
      box-shadow 280ms var(--ease);
  }

  /* Gold crown accent — revealed on hover */
  .dcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-gold) 22%,
      var(--color-gold-deep) 50%,
      var(--color-gold) 78%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 280ms var(--ease);
    z-index: 3;
    pointer-events: none;
  }

  .dcard__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .dcard__link:focus-visible {
    outline-offset: -3px;
  }

  .dcard__media {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4) var(--space-5);
    background:
      repeating-conic-gradient(
        from 22.5deg at 50% 42%,
        rgb(201 162 75 / 0.08) 0deg 5deg,
        transparent 5deg 45deg
      ),
      radial-gradient(120% 95% at 50% 0%, rgb(255 255 255 / 0.96), transparent 72%),
      linear-gradient(180deg, #fefdfb, #f7f3ea);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    isolation: isolate;
    min-height: 13rem;
  }

  /* Soft champagne glow behind the silhouette */
  .dcard__media::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 40%;
    width: 12.5rem;
    height: 12.5rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(201 162 75 / 0.24), transparent 68%);
    opacity: 0.8;
    transition:
      opacity 280ms var(--ease),
      transform 420ms var(--ease);
    pointer-events: none;
  }

  /* One-shot light sweep across the media on hover */
  .dcard__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 36%,
      rgb(255 255 255 / 0.55) 47%,
      rgb(201 162 75 / 0.16) 52%,
      transparent 64%
    );
    transform: translateX(-130%);
    opacity: 0;
    pointer-events: none;
  }

  .dcard__sil {
    position: relative;
    z-index: 1;
    color: var(--color-gold-deep);
    transition:
      color 320ms var(--ease),
      transform 420ms var(--ease);
  }

  .dcard__family {
    position: relative;
    z-index: 1;
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 280ms var(--ease);
  }

  .dcard__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    flex: 1;
  }

  .dcard__id {
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
    font-weight: 600;
  }

  .dcard__title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.12rem + 0.7vw, 1.6rem);
    line-height: var(--leading-snug);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em;
  }

  .dcard__carat {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .dcard__shape {
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    color: var(--color-gold-ink);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 0.2em 0.55em;
    border: 1px solid rgb(201 162 75 / 0.45);
    border-radius: var(--radius-pill);
    background-color: rgb(201 162 75 / 0.08);
    translate: 0 -0.15em;
  }

  .dcard__specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .dcard__specs div {
    min-width: 0;
  }

  .dcard__specs dt {
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dcard__specs dd {
    font-size: var(--text-md);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dcard__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-ink);
    transition: gap var(--duration) var(--ease);
  }

  .dcard:hover .dcard__cta {
    gap: var(--space-3);
  }

  .dcard__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-line);
    background-color: var(--color-white);
  }

  .dcard__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 34px;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background-color: var(--color-paper);
    color: var(--color-muted);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .dcard__toggle:hover {
    color: var(--color-gold-ink);
    border-color: var(--color-gold);
  }

  .dcard__toggle[aria-pressed='true'] {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-ivory);
  }

  .dcard__avail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dcard__avail::before {
    content: '';
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0.45;
  }

  .dcard__avail--on {
    color: var(--color-success);
  }

  .dcard__avail--on::before {
    opacity: 1;
    box-shadow: 0 0 0 3px rgb(47 107 79 / 0.14);
  }

  /* ---------------------------------------------------------- 3D tilt
     Fine-pointer devices only: perspective tilt driven by --rx / --ry
     (set from a tiny delegated script) plus a lift and gold rim. */
  @media (hover: hover) and (pointer: fine) {
    .dcard {
      transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
      transition:
        border-color 280ms var(--ease),
        box-shadow 280ms var(--ease),
        transform 200ms var(--ease);
    }

    .dcard:hover {
      border-color: rgb(201 162 75 / 0.7);
      box-shadow:
        0 1px 2px rgb(23 22 15 / 0.04),
        0 10px 28px rgb(23 22 15 / 0.1),
        0 22px 48px rgb(150 104 44 / 0.1);
      transform: perspective(900px) translateY(-6px) rotateX(var(--rx))
        rotateY(var(--ry));
      z-index: 2;
    }

    .dcard:hover::before {
      opacity: 1;
    }

    .dcard:hover .dcard__media {
      background:
        repeating-conic-gradient(
          from 22.5deg at 50% 42%,
          rgb(201 162 75 / 0.13) 0deg 5deg,
          transparent 5deg 45deg
        ),
        radial-gradient(120% 95% at 50% 0%, rgb(255 255 255 / 1), transparent 74%),
        radial-gradient(90% 60% at 50% 108%, rgb(201 162 75 / 0.12), transparent 72%),
        linear-gradient(180deg, #fffefc, #f6efe1);
    }

    .dcard:hover .dcard__media::before {
      opacity: 1;
      transform: scale(1.12);
    }

    .dcard:hover .dcard__media::after {
      animation: dcard-sheen 1.05s var(--ease) forwards;
    }

    .dcard:hover .dcard__sil {
      color: var(--color-gold-ink);
      transform: scale(1.06);
    }

    .dcard:hover .dcard__family {
      color: var(--color-gold-ink);
    }
  }

  @keyframes dcard-sheen {
    0% {
      transform: translateX(-130%);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    100% {
      transform: translateX(130%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dcard,
    .dcard:hover {
      transform: none;
    }

    .dcard:hover .dcard__media::after {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Progressive 3D tilt — writes --rx / --ry on the hovered card only.
   * Skipped entirely on touch devices and for prefers-reduced-motion.
   * One delegated listener for the whole page (no per-card binding).
   */
  const SELECTOR = '[data-diamond-card]';
  const MAX_DEG = 7;

  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let active: HTMLElement | null = null;

  const reset = (card: HTMLElement) => {
    card.style.setProperty('--rx', '0deg');
    card.style.setProperty('--ry', '0deg');
  };

  const tilt = (card: HTMLElement, clientX: number, clientY: number) => {
    const r = card.getBoundingClientRect();
    if (r.width === 0 || r.height === 0) return;
    const px = (clientX - r.left) / r.width - 0.5;
    const py = (clientY - r.top) / r.height - 0.5;
    card.style.setProperty('--ry', `${(px * MAX_DEG * 2).toFixed(2)}deg`);
    card.style.setProperty('--rx', `${(-py * MAX_DEG * 2).toFixed(2)}deg`);
  };

  const onMove = (e: PointerEvent) => {
    if (e.pointerType !== 'mouse') return;
    const target = e.target instanceof Element ? e.target : null;
    const card = target?.closest(SELECTOR) as HTMLElement | null;
    if (card !== active) {
      if (active) reset(active);
      active = card;
    }
    if (card) tilt(card, e.clientX, e.clientY);
  };

  const onLeaveWindow = () => {
    if (active) reset(active);
    active = null;
  };

  const attach = () => {
    document.addEventListener('pointermove', onMove, { passive: true });
    document.addEventListener('pointerleave', onLeaveWindow);
  };

  const detach = () => {
    document.removeEventListener('pointermove', onMove);
    document.removeEventListener('pointerleave', onLeaveWindow);
    onLeaveWindow();
  };

  if (finePointer.matches && !reduceMotion.matches) attach();

  finePointer.addEventListener('change', () => {
    if (finePointer.matches && !reduceMotion.matches) attach();
    else detach();
  });
  reduceMotion.addEventListener('change', () => {
    if (reduceMotion.matches) detach();
    else if (finePointer.matches) attach();
  });
</script>
